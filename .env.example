# チャット上流。OpenAI 互換プロトコルで話す。
# CHAT_MODEL には上流がそのまま認識するモデル名を書く(別名レイヤーは設けない)。
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHAT_API_KEY=sk-xxx

# 上流を変えるときは接続情報であるこの 3 行だけを差し替える。コードは変更しない。
#   DeepSeek https://api.deepseek.com/v1        deepseek-chat
#   Ollama   http://localhost:11434/v1          qwen2.5:7b  (キーは任意の文字列)
# ただしOpenAI以外に切り替える場合は、4つ目としてEXTRACT_METHODも必ず確認すること:
# function_callingに変更する(json_schemaはOpenAI固有の機能のため)。
EXTRACT_METHOD=json_schema

TOKEN_BUDGET=2000

PYTHONUTF8=1

# HTTPクライアントのタイムアウト(秒)。上流がハングした際にワーカーを無期限に塞がないための上限
REQUEST_TIMEOUT=60

# uv init --bare のためプロジェクトは venv にインストールされない。
# scripts/*.py から `import app` するには repo root を import path に載せる必要がある。
# uv run --env-file .env は python 起動前にこれを適用するので、PYTHONUTF8 と同じ仕組みで効く。
PYTHONPATH=.

# MySQL 接続先。docker-compose.yml の mysql サービス(root/root, DB名 support)に対応する。
DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/support
# テスト専用 DB。conftest.py がテストセッション開始時に作成し、終了時に破棄する。
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/support_test

# 埋め込み上流。BAAI/bge-m3 を SiliconFlow(OpenAI 互換)で利用する。
# BASE_URL と MODEL は既定値があるので、上流を変える場合だけ指定すればよい。
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# Milvus standalone(docker-compose の milvus サービス)。
# Milvus Lite は Windows 非対応のため、MySQL と同じく Docker で動かす。
MILVUS_URI=http://localhost:19530

# /kb の再実行ボタンが使う make の実体。PATH に載っていれば設定不要。
# Windows(winget)の例:
# MAKE_BIN=C:/Users/<user>/AppData/Local/Microsoft/WinGet/Packages/ezwinports.make_Microsoft.Winget.Source_8wekyb3d8bbwe/bin/make.exe

# リランク BAAI/bge-reranker-v2-m3。埋め込みと同じ SiliconFlow なら設定不要
# (未設定なら EMBED_API_KEY を使う)。上流を分ける場合だけ指定する。
# RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

# 08 章の tool system が接続する、自作の業務 MCP Server 2 台の待受先。
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp

# >0 にすると create_ticket をその秒数だけ意図的に遅延させる（write tool の timeout の実演用）。
# 通常は 0。
DEMO_TICKET_DELAY_SECONDS=0
