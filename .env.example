# チャット上流。OpenAI 互換プロトコルで話す。
# CHAT_MODEL には上流がそのまま認識するモデル名を書く(別名レイヤーは設けない)。
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHAT_API_KEY=sk-xxx

# 上流を変えるときはこの 3 行だけを差し替える。コードは変更しない。
#   DeepSeek https://api.deepseek.com/v1        deepseek-chat
#   Ollama   http://localhost:11434/v1          qwen2.5:7b  (キーは任意の文字列)
# 上のCHAT_BASE_URLをDeepSeekやOllamaに切り替える場合は、EXTRACT_METHODも
# function_callingに変更すること(json_schemaはOpenAI固有の機能のため)。
EXTRACT_METHOD=json_schema

TOKEN_BUDGET=2000

PYTHONUTF8=1

# HTTPクライアントのタイムアウト(秒)。上流がハングした際にワーカーを無期限に塞がないための上限
REQUEST_TIMEOUT=60
