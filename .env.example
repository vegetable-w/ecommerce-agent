# チャット上流。OpenAI 互換プロトコルで話す。
# CHAT_MODEL には上流がそのまま認識するモデル名を書く(別名レイヤーは設けない)。
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHAT_API_KEY=sk-xxx

# 上流を変えるときは接続情報であるこの 3 行だけを差し替える。コードは変更しない。
#   DeepSeek https://api.deepseek.com/v1        deepseek-chat
#   Ollama   http://localhost:11434/v1          qwen2.5:7b  (キーは任意の文字列)
# ただしOpenAI以外に切り替える場合は、4つ目としてEXTRACT_METHODも必ず確認すること:
# function_callingに変更する(json_schemaはOpenAI固有の機能のため)。
EXTRACT_METHOD=json_schema

TOKEN_BUDGET=2000

PYTHONUTF8=1

# HTTPクライアントのタイムアウト(秒)。上流がハングした際にワーカーを無期限に塞がないための上限
REQUEST_TIMEOUT=60

# uv init --bare のためプロジェクトは venv にインストールされない。
# scripts/*.py から `import app` するには repo root を import path に載せる必要がある。
# uv run --env-file .env は python 起動前にこれを適用するので、PYTHONUTF8 と同じ仕組みで効く。
PYTHONPATH=.

# MySQL 接続先。docker-compose.yml の mysql サービス(root/root, DB名 support)に対応する。
DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/support
# テスト専用 DB。conftest.py がテストセッション開始時に作成し、終了時に破棄する。
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/support_test
